// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: temples
// Document ID: templeId (string)
// Fields:
//   - id: number (required)
//   - name: string (required)
//   - specialty: string (optional)
//   - pro_tip: string (optional)
//   - event_id: number (optional)
//   - timings: map (required)
//   - aarti: list (optional)
//   - last_verified: string (optional)
//   - visitor_count: number (optional)
//   - maps_url: string (required)
//
// Collection: events
// Document ID: eventId (string)
// Fields:
//   - id: number (required)
//   - event: string (required)
//   - location: string (required)
//   - business_angle: string (optional)
//   - months: list (required)
//   - time: string (optional, HH:mm format)
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "shivamojha1422000@gmail.com" && request.auth.token.email_verified == true);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidTemple(data) {
      return data.id is number &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.maps_url is string && data.maps_url.matches("^https://.*");
    }

    function isValidEvent(data) {
      return data.id is number &&
             data.event is string && data.event.size() > 0 && data.event.size() < 100 &&
             data.location is string && data.location.size() > 0 &&
             data.months is list &&
             (!('time' in data) || (data.time is string && data.time.matches("^\\d{2}:\\d{2}$")));
    }

    match /temples/{templeId} {
      // Publicly readable for visitors
      allow read: if true;
      
      // Only admin can create or update
      allow create: if isAdmin() && isValidTemple(request.resource.data);
      allow update: if isAdmin() && isValidTemple(request.resource.data);
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      // Publicly readable for visitors
      allow read: if true;
      
      // Only admin can create or update
      allow create: if isAdmin() && isValidEvent(request.resource.data);
      allow update: if isAdmin() && isValidEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      // Publicly readable so app can check admin status
      allow read: if true;
      // Only admin can manage other admins
      allow write: if isAdmin();
    }

    // Collection: enquiries
// Document ID: auto-generated
// Fields:
//   - name: string (required, 1-100 chars)
//   - phone: string (required, 10-15 chars)
//   - enquiry: string (required, 1-1000 chars)
//   - timestamp: timestamp (required)

function isValidEnquiry(data) {
  return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
         data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 15 &&
         data.enquiry is string && data.enquiry.size() > 0 && data.enquiry.size() <= 1000 &&
         data.timestamp is timestamp;
}

match /enquiries/{enquiryId} {
  // Anyone can create an enquiry
  allow create: if isValidEnquiry(request.resource.data);
  // Only admin can read/list enquiries
  allow read, list: if isAdmin();
  // No updates or deletes allowed for enquiries
  allow update, delete: if false;
}
  }
}
